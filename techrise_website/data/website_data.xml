<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Website Menu Items -->
        <record id="menu_home" model="website.menu">
            <field name="name">Home</field>
            <field name="url">/</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">10</field>
            <field name="website_id" ref="website.default_website"/>
        </record>

        <record id="menu_about" model="website.menu">
            <field name="name">About Us</field>
            <field name="url">/about</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
            <field name="website_id" ref="website.default_website"/>
        </record>

        <record id="menu_services" model="website.menu">
            <field name="name">Services</field>
            <field name="url">/services</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">30</field>
            <field name="website_id" ref="website.default_website"/>
            <!-- Marks this menu as a mega-menu (is_mega_menu is computed from a
                 non-empty mega_menu_content). The actual dropdown markup is
                 rendered by our website.submenu override for url == '/services'. -->
            <field name="mega_menu_content">&lt;section class="tr-mega-src"/&gt;</field>
        </record>

        <!-- Solutions is a combined mega-menu: Solutions (products) +
             Industries (sectors) + a "The Suite" call-to-action, all in one
             two-column dropdown. A mega menu cannot own child menu items in
             Odoo, so the entire dropdown is rendered from hardcoded links in
             the tr_solutions_mega template (desktop mega + mobile list) — there
             are deliberately no child website.menu records here.
             The old standalone "The Suite" and "Industries" top items (and the
             previous Solutions child pages) are removed for existing databases
             by _tr_apply_menu_cleanup below. -->
        <record id="menu_solutions" model="website.menu">
            <field name="name">Solutions</field>
            <field name="url">/erp-suite</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">35</field>
            <field name="website_id" ref="website.default_website"/>
            <!-- Non-empty ⇒ is_mega_menu; the real markup is the template. -->
            <field name="mega_menu_content">&lt;section class="tr-sol-src"&gt;&lt;span&gt;Solutions&lt;/span&gt;&lt;/section&gt;</field>
        </record>

        <!-- Server &amp; Hosting is now a card inside the Services mega-menu,
             so its standalone top-nav item is removed. -->
        <delete model="website.menu" search="[('url','=','/server'),('website_id','=',ref('website.default_website'))]"/>

        <record id="menu_contact" model="website.menu">
            <field name="name">Contact Us</field>
            <field name="url">/contactus</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">50</field>
            <field name="website_id" ref="website.default_website"/>
        </record>

    </data>

    <!-- Branding + menu cleanup (runs on every update) -->
    <data noupdate="0">
        <record id="website.default_website" model="website">
            <field name="name">Techrise</field>
            <field name="logo" type="base64" file="techrise_website/static/src/img/logo.png"/>
        </record>

        <!-- Real company identity — fixes the "My Website" title and the
             "Company name" placeholder in the footer copyright. -->
        <record id="base.main_company" model="res.company">
            <field name="name">Techrise</field>
            <field name="phone">+971 58 595 5064</field>
        </record>

        <!-- Force Services to be a mega-menu (non-empty content ⇒ is_mega_menu).
             The real dropdown markup is rendered by the tr_services_mega
             template override for url == '/services'. -->
        <record id="menu_services" model="website.menu">
            <field name="mega_menu_content">&lt;section class="tr-mega-src"&gt;&lt;span&gt;Services&lt;/span&gt;&lt;/section&gt;</field>
        </record>

        <!-- Remove the public "Sign in" link from the header (desktop + mobile).
             portal.user_sign_in injects it into the header placeholder for the
             public group; deactivating it drops the link everywhere while
             leaving /web/login itself reachable directly. -->
        <record id="portal.user_sign_in" model="ir.ui.view">
            <field name="active" eval="False"/>
        </record>

        <!-- Re-parent all top menus to the real nav, fold The Suite + Industries
             into the Solutions mega-menu, drop duplicate/careers menus. Runs on
             every update. -->
        <function model="website" name="_tr_apply_menu_cleanup"/>
    </data>
</odoo>
